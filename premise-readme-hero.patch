From fa2bc6a83db890a3a07e0c34de5f30a9f0320abb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 12:49:10 +0000
Subject: [PATCH 1/2] fix(brain): fired cells now turn broken on the landing
 brain

The materials copied the node colour at creation, so painting a fired
check changed node.color but never the rendered sphere or halo. Broken
guarantees stayed green while their edges turned red.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TmNHAejFyUhXr6HmiYVSp3
---
 premise/web/static/brain3d.js | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/premise/web/static/brain3d.js b/premise/web/static/brain3d.js
index 24d47bb..52e9a50 100644
--- a/premise/web/static/brain3d.js
+++ b/premise/web/static/brain3d.js
@@ -249,6 +249,9 @@ async function main() {
       else if (statusOf.has(node.id)) color = stateColor(statusOf.get(node.id));
       else if (fired.has(node.id)) color = COLORS.broken;
       node.color.copy(color);
+      // Materials copy the colour at creation, so update them too or fired cells keep their resting colour.
+      node.core.material.color.copy(color);
+      node.halo.material.color.copy(color);
       const active = trace ? trace.has(node.id) : firedCheck ? (touched.has(node.id) || fired.has(node.id) || reached.has(node.id)) : true;
       node.core.material.opacity = active ? 1 : 0.18;
       node.halo.material.opacity = active ? 0.95 : 0.12;
-- 
2.43.0


