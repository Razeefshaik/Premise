GITHUB_TOKEN=
SANDBOX_REPO=Razeefshaik/kestrel-platform
SANDBOX_DIR=sandbox/kestrel-platform
SANDBOX_CLONE_DIR=.runtime/kestrel
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# Public hosting: enable this to force read-only routes and disable poller/models.
PUBLIC_DEMO=false
GRAPH_NAME=premise_kestrel
PUBLIC_BASE_URL=http://localhost:8000
POLL_SECONDS=15
POLL_ENABLED=false
AUTO_FIX_PR=false
STEWARD_ENABLED=false
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Local Windows provider: LLM_PROVIDER=codex-cli; run the app on the host, not in Docker.
# Leave CODEX_MODEL empty to use the CLI default; it is separate from LLM_MODEL.
CODEX_BINARY=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180
